# Build artifacts
/target/

# External dependencies (cloned by setup.sh)
deps/

# Persistent sandbox compilation cache
.rust-game-cache/
.rust-game-test-cache/
.rust-game-test-workspace/

# Player state (stored in user data dir, but fallback may be here)
.rust-game-state.json

# macOS metadata
.DS_Store

# Editor files
*.swp
*.swo
*~
.idea/
.vscode/

# Temporary files
*.tmp

# Internal working documents
project-plan.md
TODO.md

# Design briefs and implementation plans (personal working documents)
/docs/
/plan/
/plans/

# Your exercise solutions — personal, never committed
/workspace/

# Agent config: local settings are personal, but project skills ship with the repo.
# .claude/skills/, .codex/skills/, and .gemini/skills/ are intentionally tracked —
# they are how the lesson feature works for anyone who clones this.
.claude/settings.local.json

# Platform compatibility notes (internal)
PLATFORM_COMPAT.md

# Credentials and logs. None of these exist in this project today — the rules
# are here so that if one ever appears, it cannot be committed by accident.
# A .gitignore only prevents future commits; it does nothing about history.
.env
.env.*
*.pem
*.key
*.p12
*.pfx
credentials*
*.log
